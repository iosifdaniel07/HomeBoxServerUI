[Unit]
Description=Start HTTP server and run setup script
After=network.target

[Service]
ExecStart=/usr/bin/python3 /path/to/start_server.py
WorkingDirectory=/path/to/your/directory
Restart=always
User=your_username
Group=your_group

[Install]
WantedBy=multi-user.target


sudo nano /etc/systemd/system/start_server.service


sudo systemctl daemon-reload
sudo systemctl enable start_server.service
sudo systemctl start start_server.service
